{
  "name": "circuit-builder",
  "private": true,
  "version": "0.1.0",
  "description": "WebMCP electronics workbench with direct circuit scene construction and Arduino simulation.",
  "license": "MIT",
  "repository": "https://github.com/South-33/Circuit-Builder",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/maintenance/check-repo.mjs && tsc --noEmit && vite build",
    "test": "node scripts/testing/test-circuits.mjs",
    "harness": "node scripts/harness/run.mjs",
    "harness:list": "node scripts/harness/run.mjs --list",
    "harness:smoke": "node scripts/harness/run.mjs --input scripts/harness/examples/smoke.json --out benchmark-results/harness-smoke",
    "audit:components": "node scripts/maintenance/audit-component-grid.mjs && node scripts/maintenance/audit-component-render.mjs",
    "audit:examples": "node scripts/maintenance/audit-example-renders.mjs"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
