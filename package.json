{
  "name": "webmcp-hardware-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:repo": "node scripts/maintenance/check-repo.mjs",
    "audit:grid": "node scripts/maintenance/audit-component-grid.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/testing/test-circuits.mjs",
    "test:e2e": "node scripts/testing/test-circuits.mjs",
    "check": "pnpm check:repo && pnpm build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "benchmark:harnesses": "node scripts/benchmarks/harness-comparison.mjs",
    "audit:components": "pnpm audit:grid && node scripts/maintenance/audit-component-render.mjs",
    "audit:examples": "node scripts/maintenance/audit-example-renders.mjs"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
